{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BloodBridgeTablesOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:YOUR_ACCOUNT_ID:table/BB_Donors",
        "arn:aws:dynamodb:ap-south-1:YOUR_ACCOUNT_ID:table/BB_Requests",
        "arn:aws:dynamodb:ap-south-1:YOUR_ACCOUNT_ID:table/BB_Notifications"
      ]
    }
  ]
}
